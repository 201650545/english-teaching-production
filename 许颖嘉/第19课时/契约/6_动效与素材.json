{
  "version": "1.0",
  "courseId": "L19",
  "courseName": "复合不定代词·周末活动",
  "cssVariables": {
    "--brand": "#E63946",
    "--accent": "#FFD700",
    "--brand-light": "#FF6B6B",
    "--accent-light": "#FFE66D",
    "--bg-start": "#FFF8F0",
    "--bg-end": "#FFE8D6",
    "--text-primary": "#1A1A2E",
    "--text-secondary": "#555555",
    "--correct": "#06A77D",
    "--error": "#E63946",
    "--card-bg": "#FFFFFF",
    "--table-header-bg": "#E63946",
    "--table-header-text": "#FFFFFF",
    "--table-highlight-bg": "#FFF8E1",
    "--mnemonic-border": "#FFD700",
    "--mnemonic-text": "#E63946",
    "--error-row-bg": "#FFEBEE",
    "--correct-row-bg": "#E8F5E9",
    "--page-shadow": "0 4px 20px rgba(230, 57, 70, 0.15)",
    "--card-shadow": "0 2px 12px rgba(0, 0, 0, 0.08)"
  },
  "fontSpecs": {
    "fontFamily": "'Noto Sans SC', 'Microsoft YaHei', 'PingFang SC', sans-serif",
    "sizes": {
      "pageTitle": "40px",
      "subtitle": "26px",
      "body": "26px",
      "bodySmall": "22px",
      "tableHeader": "21px",
      "tableContent": "19px",
      "mnemonic": "38px",
      "mnemonicCard": "23px",
      "navItem": "15px",
      "pageNumber": "17px",
      "stageBadge": "15px",
      "ipa": "21px",
      "caption": "18px",
      "buttonText": "20px"
    },
    "weights": {
      "pageTitle": "700",
      "subtitle": "600",
      "body": "400",
      "mnemonic": "700",
      "navItem": "500",
      "stageBadge": "600",
      "tableHeader": "600"
    }
  },
  "animations": [
    {
      "name": "titleFadeIn",
      "target": ".page-title, .cover-title, .cover-subtitle",
      "keyframes": [
        { "opacity": 0, "transform": "translateY(-20px)" },
        { "opacity": 1, "transform": "translateY(0)" }
      ],
      "duration": "800ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [1, 2, 3, 5, 7, 9, 12, 15, 19, 25, 29]
    },
    {
      "name": "badgeBounce",
      "target": ".stage-badge",
      "keyframes": [
        { "transform": "scale(0)", "opacity": 0 },
        { "transform": "scale(1.2)", "opacity": 1, "offset": 0.6 },
        { "transform": "scale(1)", "opacity": 1 }
      ],
      "duration": "600ms",
      "easing": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
      "fillMode": "forwards",
      "pages": [1, 29]
    },
    {
      "name": "wordCardFlip",
      "target": ".word-card-inner",
      "keyframes": [
        { "transform": "rotateY(0deg)" },
        { "transform": "rotateY(180deg)" }
      ],
      "duration": "500ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [2, 3, 4, 5, 6, 7, 8]
    },
    {
      "name": "wordCardPop",
      "target": ".word-card",
      "keyframes": [
        { "transform": "scale(0)", "opacity": 0 },
        { "transform": "scale(1.1)", "opacity": 1, "offset": 0.7 },
        { "transform": "scale(1)", "opacity": 1 }
      ],
      "duration": "300ms",
      "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "fillMode": "forwards",
      "pages": [3, 5, 7],
      "stagger": "80ms"
    },
    {
      "name": "tableFade",
      "target": ".content-table",
      "keyframes": [
        { "opacity": 0 },
        { "opacity": 1 }
      ],
      "duration": "400ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [1, 4, 6, 9, 10, 12, 13, 15, 16, 25, 26]
    },
    {
      "name": "mnemonicCardFlip",
      "target": ".mnemonic-card-inner",
      "keyframes": [
        { "transform": "rotateY(0deg)" },
        { "transform": "rotateY(180deg)" }
      ],
      "duration": "500ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [1, 9, 10, 12, 15, 25, 26, 29]
    },
    {
      "name": "matrixCellHighlight",
      "target": ".matrix-cell",
      "keyframes": [
        { "background-color": "var(--card-bg)" },
        { "background-color": "var(--table-highlight-bg)", "offset": 0.5 },
        { "background-color": "var(--card-bg)" }
      ],
      "duration": "400ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [9],
      "stagger": "60ms"
    },
    {
      "name": "wordOrderSlide",
      "target": ".word-order-anim",
      "keyframes": [
        { "transform": "translateX(0)", "color": "var(--error)" },
        { "transform": "translateX(40px)", "color": "var(--accent)", "offset": 0.5 },
        { "transform": "translateX(0)", "color": "var(--accent)" }
      ],
      "duration": "600ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [12]
    },
    {
      "name": "sortBoxGlow",
      "target": ".sort-box.correct",
      "keyframes": [
        { "box-shadow": "0 0 0 rgba(255,215,0,0)" },
        { "box-shadow": "0 0 20px rgba(255,215,0,0.8)", "offset": 0.5 },
        { "box-shadow": "0 0 0 rgba(255,215,0,0)" }
      ],
      "duration": "600ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [11],
      "soundOnTrigger": "playCorrect"
    },
    {
      "name": "sortBoxShake",
      "target": ".sort-box.error",
      "keyframes": [
        { "transform": "translateX(0)" },
        { "transform": "translateX(-8px)", "offset": 0.25 },
        { "transform": "translateX(8px)", "offset": 0.5 },
        { "transform": "translateX(-4px)", "offset": 0.75 },
        { "transform": "translateX(0)" }
      ],
      "duration": "400ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [11],
      "soundOnTrigger": "playError"
    },
    {
      "name": "floatCardDrag",
      "target": ".float-card",
      "keyframes": [
        { "opacity": 0.7, "transform": "scale(1)" },
        { "opacity": 1, "transform": "scale(1.1)", "offset": 0.5 },
        { "opacity": 0.7, "transform": "scale(1)" }
      ],
      "duration": "200ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [11]
    },
    {
      "name": "matchMerge",
      "target": ".match-pair-success",
      "keyframes": [
        { "transform": "scale(1)", "box-shadow": "0 0 0 rgba(255,215,0,0)" },
        { "transform": "scale(1.15)", "box-shadow": "0 0 24px rgba(255,215,0,0.8)", "offset": 0.5 },
        { "transform": "scale(1)", "box-shadow": "0 0 0 rgba(255,215,0,0)" }
      ],
      "duration": "400ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [14],
      "soundOnTrigger": "playCorrect"
    },
    {
      "name": "matchShake",
      "target": ".match-card.error",
      "keyframes": [
        { "transform": "translateX(0)" },
        { "transform": "translateX(-6px)", "offset": 0.25 },
        { "transform": "translateX(6px)", "offset": 0.5 },
        { "transform": "translateX(-3px)", "offset": 0.75 },
        { "transform": "translateX(0)" }
      ],
      "duration": "400ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [14],
      "soundOnTrigger": "playError"
    },
    {
      "name": "flipTileCorrect",
      "target": ".flip-tile.correct",
      "keyframes": [
        { "transform": "rotateY(0deg)" },
        { "transform": "rotateY(180deg)", "offset": 0.5 },
        { "transform": "rotateY(180deg) scale(1.05)", "offset": 0.75 },
        { "transform": "rotateY(180deg) scale(1)" }
      ],
      "duration": "600ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [16],
      "soundOnTrigger": "playCorrect"
    },
    {
      "name": "flipTileError",
      "target": ".flip-tile.error",
      "keyframes": [
        { "transform": "rotateY(0deg)" },
        { "transform": "rotateY(180deg)", "offset": 0.4 },
        { "transform": "rotateY(180deg) translateX(-6px)", "offset": 0.5 },
        { "transform": "rotateY(180deg) translateX(6px)", "offset": 0.6 },
        { "transform": "rotateY(180deg) translateX(-3px)", "offset": 0.7 },
        { "transform": "rotateY(0deg)" }
      ],
      "duration": "800ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [16],
      "soundOnTrigger": "playError"
    },
    {
      "name": "maskReveal",
      "target": ".answer-mask",
      "keyframes": [
        { "opacity": 1, "visibility": "visible" },
        { "opacity": 0, "visibility": "hidden" }
      ],
      "duration": "300ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [17, 18, 20, 21, 22, 23, 24, 28],
      "soundOnTrigger": "playPageTurn"
    },
    {
      "name": "goldFlash",
      "target": ".quiz-opt.correct, .fill-correct",
      "keyframes": [
        { "box-shadow": "0 0 0 rgba(255,215,0,0)" },
        { "box-shadow": "0 0 20px rgba(255,215,0,0.8)", "offset": 0.5 },
        { "box-shadow": "0 0 0 rgba(255,215,0,0)" }
      ],
      "duration": "600ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [8, 17, 20, 21, 27, 28],
      "soundOnTrigger": "playCorrect"
    },
    {
      "name": "errorShake",
      "target": ".shake, .quiz-opt.error",
      "keyframes": [
        { "transform": "translateX(0)" },
        { "transform": "translateX(-8px)", "offset": 0.25 },
        { "transform": "translateX(8px)", "offset": 0.5 },
        { "transform": "translateX(-4px)", "offset": 0.75 },
        { "transform": "translateX(0)" }
      ],
      "duration": "400ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [8, 17, 20, 21, 27, 28],
      "soundOnTrigger": "playError"
    },
    {
      "name": "progressGrow",
      "target": ".progress-bar-fill",
      "keyframes": [
        { "width": "var(--from-width)" },
        { "width": "var(--to-width)" }
      ],
      "duration": "300ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [8, 17, 18]
    },
    {
      "name": "connectLine",
      "target": ".connect-svg path",
      "keyframes": [
        { "stroke-dashoffset": "200" },
        { "stroke-dashoffset": "0" }
      ],
      "duration": "200ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [8]
    },
    {
      "name": "celebrationBurst",
      "target": ".celebration-particle",
      "keyframes": [
        { "opacity": 0, "transform": "scale(0) translateY(0)" },
        { "opacity": 1, "transform": "scale(1) translateY(-30px)", "offset": 0.5 },
        { "opacity": 0, "transform": "scale(0.5) translateY(-60px)" }
      ],
      "duration": "1000ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [18],
      "stagger": "50ms",
      "soundOnTrigger": "playPageTurn"
    },
    {
      "name": "readingHighlight",
      "target": ".reading-passage .compound-pronoun",
      "keyframes": [
        { "background-color": "transparent" },
        { "background-color": "rgba(255,215,0,0.3)", "offset": 0.5 },
        { "background-color": "transparent" }
      ],
      "duration": "600ms",
      "easing": "ease-in-out",
      "fillMode": "forwards",
      "pages": [19],
      "stagger": "100ms"
    },
    {
      "name": "phonicsRipple",
      "target": ".audio-play-btn .ripple",
      "keyframes": [
        { "transform": "scale(0)", "opacity": 0.6 },
        { "transform": "scale(2)", "opacity": 0 }
      ],
      "duration": "600ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [25, 26, 27]
    },
    {
      "name": "phonicsRowHighlight",
      "target": ".phonics-table tr:hover",
      "keyframes": [
        { "background-color": "var(--card-bg)" },
        { "background-color": "var(--table-highlight-bg)" }
      ],
      "duration": "200ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [25, 26]
    },
    {
      "name": "wordCloudFadeIn",
      "target": ".cloud-word",
      "keyframes": [
        { "opacity": 0, "transform": "scale(0.5)" },
        { "opacity": 1, "transform": "scale(1)" }
      ],
      "duration": "300ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [29],
      "stagger": "100ms"
    },
    {
      "name": "sceneFlowPulse",
      "target": ".scene-flow-node",
      "keyframes": [
        { "box-shadow": "0 2px 12px rgba(0,0,0,0.08)", "transform": "scale(1)" },
        { "box-shadow": "0 0 16px rgba(230,57,70,0.4)", "transform": "scale(1.05)", "offset": 0.5 },
        { "box-shadow": "0 2px 12px rgba(0,0,0,0.08)", "transform": "scale(1)" }
      ],
      "duration": "800ms",
      "easing": "ease-out",
      "fillMode": "forwards",
      "pages": [7],
      "stagger": "200ms"
    }
  ],
  "transitions": [
    {
      "name": "pageTransition",
      "property": "opacity, transform",
      "duration": "300ms",
      "easing": "ease-in-out",
      "description": "页面切换时的淡入淡出效果"
    },
    {
      "name": "wordCardHover",
      "property": "transform, box-shadow",
      "duration": "200ms",
      "easing": "ease-out",
      "description": "词汇卡片悬停效果"
    },
    {
      "name": "tableRowHover",
      "property": "background-color",
      "duration": "150ms",
      "easing": "ease-out",
      "description": "表格行悬停效果"
    },
    {
      "name": "buttonHover",
      "property": "background-color, transform",
      "duration": "150ms",
      "easing": "ease-out",
      "description": "按钮悬停效果"
    },
    {
      "name": "optionSelect",
      "property": "background-color, border-color, transform",
      "duration": "200ms",
      "easing": "ease-out",
      "description": "选择题选项选中效果"
    },
    {
      "name": "maskFade",
      "property": "opacity, visibility",
      "duration": "300ms",
      "easing": "ease-in-out",
      "description": "答案遮罩揭示效果"
    },
    {
      "name": "navItemActive",
      "property": "color, border-bottom",
      "duration": "200ms",
      "easing": "ease-out",
      "description": "导航条当前环节高亮效果"
    }
  ],
  "layoutSpecs": {
    "pageAspectRatio": "21 / 9",
    "navHeight": "54px",
    "pagePadding": "30px 50px 60px",
    "maxContentWidth": "1500px",
    "scrollBehavior": {
      "overflowY": "auto",
      "scrollResetOnPageChange": true,
      "scrollbarStyle": "thin"
    },
    "pageTurnZones": {
      "leftZone": "0% - 50% width",
      "rightZone": "50% - 100% width",
      "excludedSelectors": [".answer-mask", ".q-opt", ".interact-btn", ".flip-card", ".nav-item", "input", "button", ".word-card", ".sort-box", ".float-card", ".match-card", ".flip-tile", ".reveal-mask", ".phonics-btn", ".mnemonic-card", ".reading-passage", ".progress-bar", ".audio-play-btn", ".cloud-word", ".scene-flow-node"]
    }
  },
  "responsiveSpecs": {
    "targetResolution": "1920x1080+",
    "minScale": "0.7",
    "transformOrigin": "center center"
  },
  "interactionConfigs": {
    "creative1_dragSort": {
      "page": 11,
      "function": "dragSortWord(wordId, boxId)",
      "trigger": "drag end on .float-card",
      "behavior": "将飘浮代词卡片拖入分类盒子，正确金色高亮+playCorrect，错误弹回红色闪烁+playError",
      "stopPropagation": true
    },
    "creative2_magicMatch": {
      "page": 14,
      "function": "matchPair(leftId, rightId)",
      "trigger": "click on .match-card",
      "behavior": "依次点击左右两项配对，成功合并金色发光+playCorrect，失败震动+playError",
      "stopPropagation": true
    },
    "creative3_flipChoose": {
      "page": 16,
      "function": "flipCardChoose(qId, choice)",
      "trigger": "click on .flip-tile",
      "behavior": "翻牌选择is/are，正确金色翻转+句子补全+playCorrect，错误红色震动后翻回+playError",
      "stopPropagation": true
    },
    "creative4_phonicsListen": {
      "page": 27,
      "function": "phonicsListenChoose(qId, choice)",
      "trigger": "click on .phonics-opt after audio play",
      "behavior": "播放录音后选择软音/硬音，正确金色对勾+playCorrect，错误红色叉号+playError并重播",
      "stopPropagation": true
    },
    "creative5_sceneFill": {
      "page": 18,
      "function": "revealAndFill(blankId, wordId)",
      "trigger": "click on .reveal-mask then click on .fill-option",
      "behavior": "点击遮罩揭示候选词，选择正确词填入，句子金色高亮+playCorrect，全文完成庆祝动画+playPageTurn",
      "stopPropagation": true
    },
    "wordCardFlip": {
      "pages": [2, 3, 4, 5, 6, 7, 8],
      "function": "flipWordCard(cardId)",
      "trigger": "click on .word-card",
      "behavior": "翻转词汇卡片，正面英文/背面中文释义与详细信息",
      "stopPropagation": true
    },
    "mnemonicCardFlip": {
      "pages": [1, 9, 10, 12, 15, 25, 26, 29],
      "function": "flipMnemonicCard(cardId)",
      "trigger": "click on .mnemonic-card",
      "behavior": "翻转口诀卡片，正面口诀/背面例句",
      "stopPropagation": true
    },
    "quizAnswer": {
      "pages": [8, 17, 20, 21, 27, 28],
      "function": "checkAnswer(qType, qId, userAnswer)",
      "trigger": "click on .q-opt",
      "behavior": "即时反馈，正确金色高亮+playCorrect，错误红色震动+playError",
      "stopPropagation": true
    },
    "maskReveal": {
      "pages": [17, 18, 20, 21, 22, 23, 24, 28],
      "function": "revealAnswer(maskId)",
      "trigger": "click on .answer-mask",
      "behavior": "遮罩消失揭示答案，playPageTurn音效",
      "stopPropagation": true
    },
    "audioPlay": {
      "pages": [25, 26, 27],
      "function": "playWordAudio(wordId)",
      "trigger": "click on .audio-play-btn",
      "behavior": "播放单词发音录音",
      "stopPropagation": true
    },
    "matchConnect": {
      "page": 8,
      "function": "connectMatch(leftId, rightId)",
      "trigger": "drag from .match-item-left to .match-item-right",
      "behavior": "英中词义配对连线，正确金色连线+playCorrect，错误弹回+playError",
      "stopPropagation": true
    }
  },
  "webAudioSpecs": {
    "audioContextInit": "首次用户交互时创建 AudioContext",
    "sampleRate": "44100",
    "masterGain": 0.2,
    "sounds": {
      "playCorrect": {
        "type": "oscillator-sequence",
        "frequencies": [523.25, 659.25, 783.99],
        "waveType": "triangle",
        "noteDuration": 0.1,
        "gap": 0.02,
        "envelope": { "attack": 0.01, "decay": 0.05, "sustain": 0.7, "release": 0.05 }
      },
      "playError": {
        "type": "oscillator-sequence",
        "frequencies": [392.0, 261.63],
        "waveType": "square",
        "noteDuration": 0.2,
        "gap": 0.05,
        "envelope": { "attack": 0.01, "decay": 0.1, "sustain": 0.5, "release": 0.1 }
      },
      "playPageTurn": {
        "type": "oscillator-single",
        "frequency": 800,
        "waveType": "sine",
        "duration": 0.08,
        "envelope": { "attack": 0.005, "decay": 0.02, "sustain": 0.3, "release": 0.05 },
        "noiseOverlay": true
      }
    }
  }
}
