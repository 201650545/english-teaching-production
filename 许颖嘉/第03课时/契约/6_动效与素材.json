  "creative_asset_declaration": {
    "name": "失物招领站主题视觉系统（LostFoundStation Visual System）",
    "tech": "纯CSS + 原生JS（无外部库）",
    "applied_pages": "全课25页（lost-found-tag），P3-P7（item-board），P9（possessive-builder），P10（number-builder），P11（where-locator），P24（lf-ticket）",
    "cross_lesson_unique": true,
    "fallback": "互动组件降级为静态展示，标签摆动暂停",
    "description": "失物招领站主题贯穿全课：招领标签挂牌（每页左上角，琥珀橙底色+📋图标，2s摆动动效）、失物登记板（新词展示）、方位演示器（CSS定位动画）、基数词拼写器、所有格搭配器、招领票据（总结页）",
    "key_features": [
      "lost-found-tag: 琥珀橙底色招领标签，2s ease-in-out无限循环摆动",
      "item-board: 失物招领登记板样式，每词一张登记卡",
      "where-locator: CSS position动画，物品随按钮点击在in/on/under位置间移动",
      "number-builder: 四段数字按钮，点击切换英文拼写展示",
      "possessive-builder: 有生命/无生命按钮，点击切换所有格形式",
      "lf-ticket: 模拟失物招领票据样式，总结页展示"
    ]
  }
}