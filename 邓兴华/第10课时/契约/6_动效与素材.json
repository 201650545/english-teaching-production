{
  "course": "第10课",
  "animations": {
    "css": [
      {"name": "fadeSlideUp", "definition": "from {opacity:0; transform:translateY(30px)} to {opacity:1; transform:translateY(0)}", "usage": "页面进入、内容块出现"},
      {"name": "scaleUp", "definition": "from {opacity:0; transform:scale(0.85)} to {opacity:1; transform:scale(1)}", "usage": "卡片缩放出现"},
      {"name": "bounceIn", "definition": "0%{opacity:0;transform:scale(0.3)} 50%{transform:scale(1.08)} 70%{transform:scale(0.95)} 100%{opacity:1;transform:scale(1)}", "usage": "正确反馈"},
      {"name": "bpSwing", "definition": "0%,100%{transform:rotate(-3deg)} 50%{transform:rotate(3deg)}", "usage": "错误反馈摇摆"},
      {"name": "pulse", "definition": "0%,100%{transform:scale(1)} 50%{transform:scale(1.05)}", "usage": "高亮脉冲"},
      {"name": "slideInLeft", "definition": "from {opacity:0; transform:translateX(-40px)} to {opacity:1; transform:translateX(0)}", "usage": "句子行进入"},
      {"name": "floatY", "definition": "0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)}", "usage": "emoji浮动"},
      {"name": "shimmer", "definition": "0%{background-position:-200% center} 100%{background-position:200% center}", "usage": "进度条闪光"}
    ],
    "additional": [
      {"name": "magicMorph", "definition": "0%{transform:scale(1);opacity:1} 30%{transform:scale(0.5) rotate(180deg);opacity:0.3} 60%{transform:scale(1.3) rotate(360deg);opacity:0.8} 100%{transform:scale(1) rotate(360deg);opacity:1}", "usage": "三单变形魔术动画"},
      {"name": "flipCard", "definition": "0%{transform:rotateY(0)} 50%{transform:rotateY(90deg)} 100%{transform:rotateY(180deg)}", "usage": "翻牌配对动画"},
      {"name": "doDoesFlow", "definition": "0%{transform:translateX(0);opacity:1} 50%{transform:translateX(30px);opacity:0.5} 100%{transform:translateX(60px);opacity:0}", "usage": "do/does分流动画"},
      {"name": "shakeX", "definition": "0%,100%{transform:translateX(0)} 10%,30%,50%,70%,90%{transform:translateX(-4px)} 20%,40%,60%,80%{transform:translateX(4px)}", "usage": "错误抖动"},
      {"name": "cardFlyIn", "definition": "0%{opacity:0;transform:translateY(-30px) scale(0.5) rotate(-10deg)} 60%{transform:translateY(5px) scale(1.1) rotate(2deg)} 100%{opacity:1;transform:translateY(0) scale(1) rotate(0)}", "usage": "词卡飞入"}
    ]
  },
  "interactions": {
    "navigation": {
      "halfScreenClick": true,
      "keyboardArrows": true,
      "navPills": true,
      "progressBarClick": true
    },
    "quiz": {
      "type": "checkQuiz",
      "feedback": {"correct": "蓝色✅ + bounceIn动画 + 正确音效", "wrong": "红色❌ + bpSwing动画 + 错误音效"},
      "disableAfterAnswer": true,
      "showCorrectAnswer": true
    },
    "phonics": {
      "type": "checkPhonics",
      "feedback": "同quiz"
    },
    "answerMask": {
      "type": "toggleMask",
      "initial": "蓝色遮罩显示'🔍 点击揭晓'",
      "revealed": "浅蓝色背景显示答案 + 正确音效"
    }
  },
  "interactiveComponents": {
    "component1": {
      "name": "三单变形魔术盒",
      "page": 12,
      "grammarTag": "G25",
      "elements": {
        "scene": ".singular-magic-scene",
        "subjectSelector": ["I", "You", "He", "She", "It", "We", "They"],
        "verbSelector": ["like", "watch", "study", "go", "have", "play", "work"]
      },
      "logic": {
        "selectSubject": "选择主语→判断是否三单",
        "selectVerb": "选择动词→显示原形",
        "morph": "点击变形按钮→magicMorph动画→显示三单形式（高亮变化部位）",
        "toggleNegative": "切换否定→显示doesn't + 原形",
        "toggleQuestion": "切换疑问→显示Does + 主语 + 原形?",
        "highlightRule": "高亮适用的变化规则（如'ch结尾加es'）"
      }
    },
    "component2": {
      "name": "课程表对话器",
      "page": 17,
      "grammarTag": "G27",
      "elements": {
        "scene": ".timetable-scene",
        "persons": [
          {"name": "Tom", "icon": "👦"},
          {"name": "Lily", "icon": "👧"},
          {"name": "the teacher", "icon": "👨‍🏫"}
        ],
        "subjects": [
          {"name": "Chinese", "icon": "🇨🇳"},
          {"name": "math", "icon": "➗"},
          {"name": "physics", "icon": "⚛️"},
          {"name": "geography", "icon": "🗺️"},
          {"name": "biology", "icon": "🧬"}
        ],
        "actions": ["studies", "reads", "finishes", "begins", "understands"]
      },
      "logic": {
        "selectPerson": "选择人物（三单主语）",
        "selectSubject": "选择学科",
        "selectAction": "选择动作（已变三单形式）",
        "generateSentence": "生成: [人物] [动作] [学科].",
        "toggleNegative": "切换否定: [人物] doesn't [原形] [学科].",
        "toggleQuestion": "切换疑问: Does [人物] [原形] [学科]?"
      }
    }
  },
  "audio": {
    "correct": {"freq": [880, 1100], "duration": [0.15, 0.2], "type": "sine"},
    "error": {"freq": 220, "duration": 0.3, "type": "sawtooth"},
    "pageTurn": {"freq": 440, "duration": 0.1, "type": "triangle"},
    "magicMorph": {"type": "magic-chime", "description": "魔法变形音效"}
  },
  "assets": {
    "emojis": ["🇨🇳", "➗", "⚛️", "🗺️", "🧬", "📚", "📖", "💪", "🔄", "✅", "🏁", "💡", "❓", "💬", "🧩", "🤷", "😊", "⚡", "🔍", "👥", "👦", "👧", "👨‍🏫", "✅", "❌"],
    "images": "none (all CSS/emoji based)",
    "externalLibs": "none (vanilla JS)"
  }
}
