{
  "course": "第18课",
  "animations": {
    "css": [
      {"name": "fadeSlideUp", "definition": "from {opacity:0; transform:translateY(30px)} to {opacity:1; transform:translateY(0)}", "usage": "页面进入、内容块出现"},
      {"name": "scaleUp", "definition": "from {opacity:0; transform:scale(0.85)} to {opacity:1; transform:scale(1)}", "usage": "卡片缩放出现"},
      {"name": "bounceIn", "definition": "0%{opacity:0;transform:scale(0.3)} 50%{transform:scale(1.08)} 70%{transform:scale(0.95)} 100%{opacity:1;transform:scale(1)}", "usage": "正确反馈"},
      {"name": "bpSwing", "definition": "0%,100%{transform:rotate(-3deg)} 50%{transform:rotate(3deg)}", "usage": "错误反馈摇摆"},
      {"name": "pulse", "definition": "0%,100%{transform:scale(1)} 50%{transform:scale(1.05)}", "usage": "高亮脉冲"},
      {"name": "slideInLeft", "definition": "from {opacity:0; transform:translateX(-40px)} to {opacity:1; transform:translateX(0)}", "usage": "句子行进入"},
      {"name": "floatY", "definition": "0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)}", "usage": "emoji浮动"},
      {"name": "shimmer", "definition": "0%{background-position:-200% center} 100%{background-position:200% center}", "usage": "进度条闪光"}
    ],
    "additional": [
      {"name": "actionPulse", "definition": "0%,100%{transform:scale(1);box-shadow:0 0 0 0 rgba(194,65,12,0.4)} 50%{transform:scale(1.05);box-shadow:0 0 0 10px rgba(194,65,12,0)}", "usage": "动作脉冲"},
      {"name": "markerGlow", "definition": "0%{box-shadow:0 0 5px rgba(14,165,233,0.3)} 50%{box-shadow:0 0 20px rgba(14,165,233,0.8)} 100%{box-shadow:0 0 5px rgba(14,165,233,0.3)}", "usage": "标志词发光"},
      {"name": "shakeX", "definition": "0%,100%{transform:translateX(0)} 10%,30%,50%,70%,90%{transform:translateX(-4px)} 20%,40%,60%,80%{transform:translateX(4px)}", "usage": "错误抖动"},
      {"name": "cardFlyIn", "definition": "0%{opacity:0;transform:translateY(-30px) scale(0.5) rotate(-10deg)} 60%{transform:translateY(5px) scale(1.1) rotate(2deg)} 100%{opacity:1;transform:translateY(0) scale(1) rotate(0)}", "usage": "词卡飞入"},
      {"name": "ingPop", "definition": "0%{transform:scale(0) rotate(-180deg)} 60%{transform:scale(1.3) rotate(10deg)} 100%{transform:scale(1) rotate(0)}", "usage": "V-ing后缀弹出"}
    ]
  },
  "interactions": {
    "navigation": {
      "halfScreenClick": true,
      "pageTurnExemption": ["quiz-q", "quiz-container", "drag-container", "link-container", "chore-container", "marker-container"],
      "answerRevealPriority": true,
      "keyboardArrows": true,
      "navPills": true
    },
    "quiz": {
      "type": "checkOpt",
      "containerResolve": "btn.closest('.quiz-container')||btn.closest('.quiz-q')",
      "feedback": {
        "correct": "橙红✅ + bounceIn动画 + 正确音效",
        "wrong": "红色❌ + bpSwing动画 + 错误音效"
      },
      "undo": {
        "doubleClick": true,
        "description": "答错后双击可撤销重答"
      },
      "disableAfterAnswer": false,
      "showCorrectAnswer": true
    },
    "dataCollection": {
      "type": "IndexedDB",
      "recordAnswer": true,
      "recordUndo": true,
      "syncMode": "realtime",
      "exportFormats": ["json", "csv"]
    },
    "phonics": {
      "type": "checkPhonics",
      "feedback": "同quiz"
    },
    "answerMask": {
      "type": "toggleMask",
      "initial": "橙色遮罩显示'🔍 点击揭晓'",
      "revealed": "浅橙背景显示答案 + 正确音效"
    }
  },
  "interactiveComponents": {
    "component1": {
      "name": "家务动作演示板",
      "grammarTag": "G46",
      "elements": {
        "scene": ".chore-demo-scene",
        "members": ["mom", "dad", "brother", "sister", "I"],
        "actions": ["cook", "wash", "sweep", "read"]
      },
      "logic": {
        "selectMember": "选择家庭成员",
        "selectAction": "选择家务动作",
        "generateSentence": "生成进行时句子",
        "toggleNegative": "切换肯定/否定",
        "highlight": "高亮be + V-ing结构"
      }
    },
    "component2": {
      "name": "标志词探测仪",
      "grammarTag": "G48",
      "elements": {
        "scene": ".marker-detector-scene",
        "markers": ["now", "look!", "listen!", "at the moment", "right now"]
      },
      "logic": {
        "selectMarker": "选择标志词",
        "selectSubject": "选择主语",
        "selectVerb": "选择动词",
        "generateSentence": "生成进行时句子",
        "highlight": "高亮标志词"
      }
    }
  },
  "audio": {
    "correct": {"freq": [880, 1100], "duration": [0.15, 0.2], "type": "sine"},
    "error": {"freq": 220, "duration": 0.3, "type": "sawtooth"},
    "pageTurn": {"freq": 440, "duration": 0.1, "type": "triangle"},
    "actionChime": {"type": "action-chime", "description": "家务动作音效"}
  },
  "assets": {
    "emojis": ["🏠", "🧹", "💧", "👨‍🍳", "📱", "📕", "✏️", "🎨", "🎵", "💃", "📝", "😴", "💬", "🗣️", "👂", "☕", "👀", "🗨️", "⚠️", "⏰", "🔍", "✅", "❌", "💡"],
    "images": "none (all CSS/emoji based)",
    "externalLibs": "none (vanilla JS)"
  }
}
